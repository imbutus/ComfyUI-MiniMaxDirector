      "widgets_values": [
        "{\n  \"version\": 1,\n  \"fps\": 24,\n  \"dialect\": \"timeline\",\n  \"global_prompt\": \"Editorial neon-noir short. Rain-slick alley, cyan and magenta signage, 35mm grain, shallow depth of field. Keep the subject from <Picture 1> consistent throughout.\",\n  \"shots\": [\n    {\n      \"start\": 0,\n      \"length\": 34,\n      \"prompt\": \"Wide establishing shot of the alley, puddles holding the sign reflections.\",\n      \"camera\": \"dolly_in\"\n    },\n    {\n      \"start\": 34,\n      \"length\": 45,\n      \"prompt\": \"Medium shot: the subject from <Picture 1> steps into the magenta light.\",\n      \"camera\": \"pan_right\"\n    },\n    {\n      \"start\": 79,\n      \"length\": 45,\n      \"prompt\": \"Close on the face, rain beading on the collar, a slow blink.\",\n      \"camera\": \"static\"\n    }\n  ],\n  \"moves\": [\n    {\n      \"start\": 0,\n      \"length\": 34,\n      \"camera\": \"dolly_in\",\n      \"prompt\": \"\"\n    },\n    {\n      \"start\": 34,\n      \"length\": 45,\n      \"camera\": \"pan_right\",\n      \"prompt\": \"following the subject\"\n    },\n    {\n      \"start\": 79,\n      \"length\": 45,\n      \"camera\": \"static\",\n      \"prompt\": \"\"\n    }\n  ],\n  \"cues\": [\n    {\n      \"start\": 0,\n      \"length\": 60,\n      \"prompt\": \"Distant siren over steady rain on metal.\"\n    },\n    {\n      \"start\": 60,\n      \"length\": 64,\n      \"prompt\": \"The rain thins; a low synth pad swells.\"\n    }\n  ],\n  \"references\": [\n    {\n      \"kind\": \"picture\",\n      \"index\": 1,\n      \"label\": \"subject\"\n    }\n  ]\n}",
